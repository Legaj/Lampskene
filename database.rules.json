{
  "rules": {
    ".read": false,
    ".write": false,

    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "profilesByEmail": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && (!newData.exists() || newData.val() == auth.uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)"
      }
    },

    "usernames": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "parties": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "rounds": {
      ".read": "auth != null",
      "$roundId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() == true || (!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid))"
      }
    },

    "roundQuestions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "roundEndgame": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "roundDrafts": {
      "$roundId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "roundTrackerTimeline": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "trackers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$trackerId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() == true || root.child('trackerAccess').child(auth.uid).child($trackerId).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "trackerAccess": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
      }
    },

    "trackerLocations": {
      "$trackerId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() == true || root.child('trackerAccess').child(auth.uid).child($trackerId).val() == true)",
        ".write": "auth != null && newData.child('deviceId').val() == $trackerId",
        ".validate": "newData.hasChildren(['deviceId','lat','lng','updatedAt']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('updatedAt').isNumber()"
      }
    }
  }
}
